# Lean MemoryOS Router - No torch, opencv-python, or yt-dlp
# Target size: ~150MB
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /usr/sbin/nologin memoryos

COPY requirements-router.txt .
RUN pip install --no-cache-dir -r requirements-router.txt

COPY schema.sql server.py ./
COPY quiet_advisor_detectors.py quiet_advisor_scheduler.py ./
COPY src ./src
COPY apps/quiet_advisor_ui ./apps/quiet_advisor_ui

RUN mkdir -p /app/memory/checkpoints /app/tlb_hot_cache /app/graph \
    && chown -R memoryos:memoryos /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    ROUTER_HOST=0.0.0.0 \
    ROUTER_PORT=5000 \
    QUIET_ADVISOR_DB=/app/QuietAdvisorDB.sqlite

USER memoryos

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import os, urllib.request; port = os.environ.get('ROUTER_PORT', '5000'); urllib.request.urlopen(f'http://127.0.0.1:{port}/health')" || exit 1

ENTRYPOINT ["python", "server.py"]
