# MemoryOS + Quiet Advisor + Jupiter TV
# Copy to .env and fill in your keys

# Token Lab (AMD decision routing)
TOKENLAB_API_KEY=your-token-lab-api-key-here

# NVIDIA API (Nemotron, LLaMA, etc.)
NVIDIA_API_KEY=your-nvidia-api-key-here

# OpenAI (fallback chat models)
OPENAI_API_KEY=your-openai-api-key-here

# Data path (for video dataset)
DATASET_PATH=./data

# GPU selection (for Riva + CUDA)
CUDA_VISIBLE_DEVICES=0

# Memory tuning
MEMORYOS_HEAT_THRESHOLD=0.7
MEMORYOS_TLB_MAX_HOT=5
MEMORYOS_PREFETCH_TOKENS=256
