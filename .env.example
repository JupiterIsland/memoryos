# AMD Token Lab API Configuration (OpenAI-compatible client + /v1/systemone)
TOKENLAB_API_KEY="tl-your-tokenlab-key-here"
TOKENLAB_BASE_URL="https://api.tokenlab.amd.com/v1"

# DigitalOcean Serverless Inference / Inference Router (AMD Instinct MI300X Cloud Tier)
DO_MODEL_ACCESS_KEY="do-ai-your-model-access-key-here"
DO_INFERENCE_BASE_URL="https://inference.do-ai.run/v1"
DIGITALOCEAN_API_TOKEN="dop_v1_your-digitalocean-api-token-here"

# NVIDIA NIM / Brev OpenAI-compatible Cloud Inference
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
BREV_ORG_ID="org-your-brev-org-id"

# Optional SQLite database override (defaults to QuietAdvisorDB.sqlite)
QUIET_ADVISOR_DB="QuietAdvisorDB.sqlite"
MEMORYOS_ROUTER_URL="http://127.0.0.1:5000"
