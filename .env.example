# ═══════════════════════════════════════════════════════════════════════════
# MemoryOS — Environment Configuration (.env.example)
#
# Copy to .env and fill in the values you actually have. Any value still
# containing "your-...-here" is treated as NOT configured by the router, so
# leaving placeholders in place is safe — the router falls back to the next
# configured provider, then to Local Ollama, then to offline deterministic mode.
# ═══════════════════════════════════════════════════════════════════════════

# ── AMD Token Lab (default flagship provider) ──────────────────────────────
# OpenAI-compatible at {BASE}/chat/completions; d3 systemone at {BASE}/systemone.
# BASE already includes the /v1 suffix — the router appends the resource path.
TOKENLAB_API_KEY="tl-your-tokenlab-key-here"
TOKENLAB_BASE_URL="https://api.tokenlab.amd.com/v1"

# ── DigitalOcean Serverless Inference (AMD Instinct MI300X failover) ───────
# DO_MODEL_ACCESS_KEY is the inference key. DIGITALOCEAN_API_TOKEN is only
# needed by installer/deploy-digitalocean.sh to provision a Droplet — it is
# not used for inference routing.
DO_MODEL_ACCESS_KEY="do-ai-your-model-access-key-here"
DO_INFERENCE_BASE_URL="https://inference.do-ai.run/v1"
DIGITALOCEAN_API_TOKEN="dop_v1_your-digitalocean-api-token-here"

# ── NVIDIA NIM / Brev (OpenAI-compatible cloud inference) ──────────────────
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
BREV_ORG_ID="org-your-brev-org-id"

# ── Groq, OpenRouter & Cerebras (Cloud Fast-Coding / Multi-Model Pool) ─────
GROQ_API_KEY="gsk_your-groq-key-here"
GROQ_BASE_URL="https://api.groq.com/openai/v1"
OPENROUTER_API_KEY="sk-or-your-openrouter-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
CEREBRAS_API_KEY="csk-your-cerebras-key-here"
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
HF_TOKEN="hf_your-token-here"

# ── Google Gemini API (Interactions v1) & OpenAI Cloud ────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Local Ollama (fast-light provider for Jupiter Studio) ──────────────────
OLLAMA_HOST="http://127.0.0.1:11434"

# ── AMD Lemonade Server (Ryzen AI XDNA 2 NPU / FastFlowLM) ───────────────
# OpenAI-compatible local server (default port 13305). No API key required locally.
LEMONADE_BASE_URL="http://127.0.0.1:13305/api/v1"
LEMONADE_API_KEY="EMPTY"

# ── DGX Spark / GB10 Local OpenAI-Compatible Servers (vLLM / NVIDIA Flare) ─
LOCAL_VLLM_BASE_URL="http://127.0.0.1:8000/v1"
LOCAL_VLLM_API_KEY="EMPTY"
NVIDIA_FLARE_BASE_URL="http://127.0.0.1:8080/v1"
NVIDIA_FLARE_API_KEY="EMPTY"

# ── Default flagship model (uncomment to override d3 auto-selection) ───────
# MEMORYOS_DEFAULT_MODEL="Gemma-4-31B-IT"

# ── MemoryOS Router + Quiet Advisor ────────────────────────────────────────
MEMORYOS_ROUTER_URL="http://127.0.0.1:5000"
QUIET_ADVISOR_DB="QuietAdvisorDB.sqlite"

# ── Jupiter Studio (web workbench) ─────────────────────────────────────────
JUPITER_STUDIO_HOST="127.0.0.1"
JUPITER_STUDIO_PORT="7860"

# ── Speculative Offload Head thresholds (v0.2.x beta) ──────────────────────
# p >= TAU_HI  → offload_now (warm remote KV cache)
# p <= TAU_LO  → skip        (no network)
# otherwise    → digest      (128-byte context digest)
JUPITER_TAU_HI="0.65"
JUPITER_TAU_LO="0.35"

# ── Python stdio encoding (prevents UnicodeDecodeError on WSL / CI) ────────
PYTHONIOENCODING="utf-8"
